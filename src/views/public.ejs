              <textarea id="perfil-bio" rows="2" class="w-full rounded-xl p-2.5 text-xs focus:outline-none resize-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Conte um pouco sobre você..."></textarea>
            </div>
