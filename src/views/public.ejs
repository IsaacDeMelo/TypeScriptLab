          <button id="perfil-save-btn" onclick="salvarPerfil()" class="w-full text-white font-bold py-2.5 rounded-2xl text-xs transition-all active:scale-[0.97]" style="background: var(--accent);">
            <i class="fa-solid fa-check"></i> Salvar Perfil
          </button>

          <div>
            <h4 id="perfil-reviews-title" class="text-[11px] font-bold font-title mb-3 flex items-center gap-2" style="color: var(--text-primary);">
              <i class="fa-solid fa-comment text-[10px]" style="color: var(--accent);"></i>
              <span id="perfil-reviews-heading">Minhas Críticas</span>
