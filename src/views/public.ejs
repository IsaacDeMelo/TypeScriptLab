              <label class="flex items-center gap-3 p-3 text-xs cursor-pointer" style="color: var(--text-secondary);" for="edit-banner">
                <span class="p-2 rounded-lg border" style="background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 30%, transparent);">
                  <i class="fa-solid fa-image text-sm"></i>
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium" style="color: var(--text-secondary);">Substituir banner</p>
