    function fecharModalRegistroRpg() {
      const modal = document.getElementById('modal-registrar-rpg');
      modal.classList.remove('registro-aberto');
      document.getElementById('reg-rpg-error').classList.add('hidden');
      setTimeout(() => modal.classList.add('modal-hidden'), 300);
