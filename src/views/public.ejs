    <!-- MODAL DE AVALIAÇÕES PENDENTES (ADMIN) -->
    <div id="modal-pendentes" class="modal-hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
