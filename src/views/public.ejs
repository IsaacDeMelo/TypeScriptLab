      <div id="theme-panel-content" class="hidden rounded-l-2xl shadow-2xl p-5 border-r" style="background: var(--bg-elevated); border-color: var(--border); width: 260px;">
        <div class="flex justify-between items-center mb-4">
          <h4 class="text-xs font-bold font-title tracking-wide" style="color: var(--text-primary);">Cores do Tema</h4>
          <button onclick="toggleThemePanel()" class="text-xs" style="color: var(--text-muted);"><i class="fas fa-times"></i></button>
        </div>
        <div class="space-y-3 text-[11px]">
          <div><label class="font-medium" style="color: var(--text-secondary);">Fundo Principal</label><input type="color" id="cp-bg-primary" value="#0b0f19" onchange="aplicarCor('--bg-primary', this.value)" class="color-picker w-full h-8 rounded-xl cursor-pointer border mt-1" style="border-color: var(--border);"></div>
          <div><label class="font-medium" style="color: var(--text-secondary);">Fundo Secundário</label><input type="color" id="cp-bg-secondary" value="#0f1524" onchange="aplicarCor('--bg-secondary', this.value)" class="color-picker w-full h-8 rounded-xl cursor-pointer border mt-1" style="border-color: var(--border);"></div>
          <div><label class="font-medium" style="color: var(--text-secondary);">Fundo Cards</label><input type="color" id="cp-bg-card" value="#111827" onchange="aplicarCor('--bg-card', this.value)" class="color-picker w-full h-8 rounded-xl cursor-pointer border mt-1" style="border-color: var(--border);"></div>
          <div><label class="font-medium" style="color: var(--text-secondary);">Cor de Destaque</label><input type="color" id="cp-accent" value="#e50914" onchange="aplicarCor('--accent', this.value)" class="color-picker w-full h-8 rounded-xl cursor-pointer border mt-1" style="border-color: var(--border);"></div>
          <div><label class="font-medium" style="color: var(--text-secondary);">Texto Principal</label><input type="color" id="cp-text-primary" value="#f1f5f9" onchange="aplicarCor('--text-primary', this.value)" class="color-picker w-full h-8 rounded-xl cursor-pointer border mt-1" style="border-color: var(--border);"></div>
          <div><label class="font-medium" style="color: var(--text-secondary);">Texto Secundário</label><input type="color" id="cp-text-secondary" value="#94a3b8" onchange="aplicarCor('--text-secondary', this.value)" class="color-picker w-full h-8 rounded-xl cursor-pointer border mt-1" style="border-color: var(--border);"></div>
          <div><label class="font-medium" style="color: var(--text-secondary);">Cor das Estrelas</label><input type="color" id="cp-star" value="#f59e0b" onchange="aplicarCor('--star', this.value)" class="color-picker w-full h-8 rounded-xl cursor-pointer border mt-1" style="border-color: var(--border);"></div>
        </div>
        <div class="flex gap-2 mt-4">
          <button onclick="resetarTema()" class="flex-1 py-2 rounded-xl text-xs font-semibold transition" style="background: var(--bg-input); color: var(--text-secondary); border: 1px solid var(--border);">Resetar</button>
          <button onclick="exportarTema()" class="flex-1 py-2 rounded-xl text-xs font-semibold transition text-white" style="background: var(--accent);">Exportar</button>
        </div>
      </div>
    </div>

    <!-- MODAL DE PERFIL -->
    <div id="modal-perfil" onclick="if(event.target===this)fecharPerfil()" class="modal-hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-3xl w-full max-w-md max-h-[90vh] overflow-y-auto shadow-2xl" style="background: var(--bg-card); border: 1px solid var(--border);">
        
        <!-- Cover / Topo -->
        <div class="relative h-28 rounded-t-3xl flex items-end justify-center" style="background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 60%, #000));">
          <button onclick="fecharPerfil()" class="absolute top-3 right-3 w-7 h-7 rounded-full flex items-center justify-center text-white text-xs transition active:scale-90" style="background: rgba(0,0,0,0.3);"><i class="fas fa-times"></i></button>
          <div class="relative -mb-10 w-20 h-20 rounded-full overflow-hidden border-[3px] shadow-lg" style="border-color: var(--bg-card);">
            <img id="perfil-avatar" class="w-full h-full object-cover hidden" src="" alt="">
            <div id="perfil-avatar-placeholder" class="w-full h-full flex items-center justify-center text-2xl font-bold text-white" style="background: var(--accent);">U</div>
          </div>
        </div>

