          <div class="text-center">
            <p class="text-base font-bold" style="color: var(--text-primary);" id="perfil-nome">Carregando...</p>
            <div class="inline-block mt-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider" id="perfil-role" style="background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent);">Usuário</div>
          </div>

          <div class="flex items-start gap-3 p-3 rounded-2xl" style="background: var(--bg-elevated);">
            <label id="perfil-camera-label" class="cursor-pointer shrink-0 w-9 h-9 rounded-full flex items-center justify-center text-xs transition active:scale-90" style="background: var(--bg-input); color: var(--text-muted); border: 1px solid var(--border);" title="Alterar foto">
              <i class="fa-solid fa-camera"></i>
              <input type="file" id="perfil-avatar-input" accept=".jpg,.jpeg,.png,.webp" class="hidden" onchange="enviarAvatar(event)">
