          <div><label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">WhatsApp</label><input type="url" id="edit-whatsapp" class="w-full rounded-xl p-2.5 text-xs focus:outline-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="https://wa.me/..."></div>
          <div><label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">Descrição</label><textarea id="edit-desc" rows="3" class="w-full rounded-xl p-2.5 text-xs focus:outline-none resize-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);"></textarea></div>
          <div><label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">Tags <span style="color: var(--text-muted);">(separadas por vírgula)</span></label><input type="text" id="edit-tags" class="w-full rounded-xl p-2.5 text-xs focus:outline-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="ex: anime, cards, cenas, textual"></div>
          <div class="flex items-center justify-between p-3 rounded-xl" style="background: var(--bg-input); border: 1px solid var(--border);">
