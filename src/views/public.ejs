    async function registrarRpg(event) {
      event.preventDefault();
      const errorEl = document.getElementById('reg-rpg-error');
      errorEl.classList.add('hidden');
      const token = getToken();
      if (!token) { fecharModalRegistroRpg(); abrirModalLogin(); return; }
      const formData = new FormData();
      formData.append('name', document.getElementById('reg-nome').value.trim());
      formData.append('owner', document.getElementById('reg-owner').value.trim());
      formData.append('genre', document.getElementById('reg-genre').value.trim());
      formData.append('year', document.getElementById('reg-year').value.trim());
      formData.append('ageRating', document.getElementById('reg-age').value);
      formData.append('blurImage', document.getElementById('reg-blur').checked);
      formData.append('description', document.getElementById('reg-desc').value.trim());
      const link = document.getElementById('reg-link').value.trim();
      if (link) formData.append('link', link);
      const whatsapp = document.getElementById('reg-whatsapp').value.trim();
      if (whatsapp) formData.append('whatsapp', whatsapp);
      const imgFile = croppedImageFile || document.getElementById('reg-image').files[0];
      if (imgFile) formData.append('image', imgFile);
      const bannerFile = croppedBannerFile || document.getElementById('reg-banner').files[0];
      if (bannerFile) formData.append('banner', bannerFile);
      croppedImageFile = null;
      croppedBannerFile = null;
      try {
        const res = await fetch('/api/rpgs', { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, body: formData });
        const data = await res.json();
        if (!res.ok) { errorEl.textContent = data.error; errorEl.classList.remove('hidden'); return; }
        fecharModalRegistroRpg();
        await refreshData();
      } catch { errorEl.textContent = 'Erro ao conectar com o servidor.'; errorEl.classList.remove('hidden'); }
    }

    function deletarAvaliacao(id, btnEl) {
      if (!confirm('Excluir esta avaliação?')) return;
      const user = getUser();
      if (!user) return;
      fetch(`/api/reviews/${id}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() }
      })
      .then(r => r.json())
      .then(data => {
        if (data.error) { alert(data.error); return; }
        const card = btnEl.closest('.feed-card, .pendente-card');
        if (card) card.remove();
        catReviewData = catReviewData.filter(r => r.id !== id);
        allReviewData = allReviewData.filter(r => r.id !== id);
        atualizarMediasCatalogo();
      })
      .catch(() => alert('Erro ao excluir.'));
    }

    function abrirModalPendentes() {
      const modal = document.getElementById('modal-pendentes');
      modal.classList.remove('modal-hidden');
      const list = document.getElementById('pendentes-list');
      if (pendingReviewsData.length === 0) {
        list.innerHTML = '<p class="text-xs text-center py-8" style="color: var(--text-muted);">Nenhuma avaliação pendente.</p>';
        return;
      }
      list.innerHTML = pendingReviewsData.map(r => `
        <div class="pendente-card rounded-2xl p-4 border" style="background: color-mix(in srgb, var(--bg-card) 40%, transparent); border-color: var(--border);">
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-center gap-3">
              <img src="${r.customImage || r.rpg.image}" class="w-10 h-12 object-cover rounded-lg shadow" alt="">
              <div>
                <p class="text-xs font-bold" style="color: var(--text-primary);">${r.rpg.name}</p>
                <p class="text-[10px]" style="color: var(--text-muted);">por ${r.username}</p>
                <div class="flex items-center gap-1 mt-1 text-[10px]" style="color: var(--star);">
                  ${'★'.repeat(Math.floor(r.rating))}${r.rating % 1 ? '½' : ''}
                  <span class="text-[9px] ml-1 font-semibold" style="color: var(--star);">${r.rating}</span>
                </div>
              </div>
            </div>
          </div>
          <p class="text-[11px] leading-relaxed mb-3" style="color: var(--text-secondary);">${r.comment}</p>
          <div class="flex gap-2">
            <button onclick="aprovarAvaliacao('${r.id}')" class="flex-1 py-2 rounded-xl text-[10px] font-bold transition-all active:scale-[0.97] text-white" style="background: #22c55e;">
              <i class="fa-solid fa-check mr-1"></i>Aprovar
            </button>
            <button onclick="rejeitarAvaliacao('${r.id}')" class="flex-1 py-2 rounded-xl text-[10px] font-bold transition-all active:scale-[0.97] text-white" style="background: #ef4444;">
              <i class="fa-solid fa-times mr-1"></i>Rejeitar
            </button>
            <button onclick="deletarAvaliacao('${r.id}', this)" class="px-3 py-2 rounded-xl text-[10px] font-bold transition-all active:scale-[0.97]" style="color: var(--text-muted); background: color-mix(in srgb, var(--text-muted) 10%, transparent); border: 1px solid var(--border);">
              <i class="fa-solid fa-trash-alt"></i>
            </button>
          </div>
        </div>
      `).join('');
    }

    function fecharModalPendentes() {
      document.getElementById('modal-pendentes').classList.add('modal-hidden');
    }

    function aprovarAvaliacao(id) {
      fetch(`/api/reviews/${id}/approve`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() }
      })
      .then(r => r.json())
      .then(data => {
        if (data.error) { alert(data.error); return; }
        pendingReviewsData = pendingReviewsData.filter(r => r.id !== id);
        catReviewData.push(data);
        allReviewData = allReviewData.map(r => r.id === data.id ? data : r);
        atualizarNavbar();
        atualizarMediasCatalogo();
        abrirModalPendentes();
      })
      .catch(() => alert('Erro ao aprovar.'));
    }

    function rejeitarAvaliacao(id) {
      fetch(`/api/reviews/${id}/reject`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() }
      })
      .then(r => r.json())
      .then(data => {
        if (data.error) { alert(data.error); return; }
        pendingReviewsData = pendingReviewsData.filter(r => r.id !== id);
        allReviewData = allReviewData.filter(r => r.id !== id);
        atualizarNavbar();
        atualizarMediasCatalogo();
        abrirModalPendentes();
      })
      .catch(() => alert('Erro ao rejeitar.'));
    }

    function atualizarNavbar() {
      const user = getUser();
      const btnUser = document.getElementById('btn-user');
      const btnLogin = document.getElementById('btn-login');
      const userName = document.getElementById('user-name');
      const avatarImg = document.getElementById('user-avatar-img');
      const avatarLetter = document.getElementById('user-avatar-letter');
      const adminSection = document.getElementById('cat-admin-section');
      if (user) {
        btnUser.classList.remove('hidden');
        btnLogin.classList.add('hidden');
        if (user.avatar) { avatarImg.src = user.avatar; avatarImg.classList.remove('hidden'); avatarLetter.classList.add('hidden'); }
        else { avatarImg.classList.add('hidden'); avatarLetter.classList.remove('hidden'); avatarLetter.textContent = user.username.charAt(0).toUpperCase(); }
        if (adminSection) {
          adminSection.classList.toggle('hidden', user.role !== 'admin');
        }
        const badge = document.getElementById('pending-count-badge');
        if (badge) badge.textContent = pendingReviewsData.length || '';
        document.querySelectorAll('.review-delete-btn').forEach(btn => {
          const owner = btn.getAttribute('data-owner');
          btn.classList.toggle('hidden', !(user && (user.role === 'admin' || user.username === owner)));
        });
      } else {
        btnUser.classList.add('hidden');
        btnLogin.classList.remove('hidden');
        if (adminSection) adminSection.classList.add('hidden');
      }
    }

    let currentSort = 'nome';
    let catRpgData = <%- JSON.stringify(rpgs) %>;
    let catReviewData = <%- JSON.stringify(reviews) %>;
    let pendingReviewsData = <%- JSON.stringify(pendingReviews) %>;
    let allReviewData = <%- JSON.stringify(allReviews) %>;
    let catUsersData = <%- JSON.stringify(users) %>;

    function toSlug(name) {
      return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }

    let rpgModalOpen = false;

    window.addEventListener('popstate', function() {
      const path = window.location.pathname;
      const match = path.match(/^\/rpg\/(.+)$/);
      if (match) {
        const slug = match[1];
        const rpg = catRpgData.find(r => toSlug(r.name) === slug);
        if (rpg) abrirDetalheRpg(rpg.name, true);
      } else if (rpgModalOpen) {
        fecharDetalheRpg(true);
      }
    });

    <%
    if (typeof initialRpg !== 'undefined') {
    %>
    document.addEventListener('DOMContentLoaded', function() {
      abrirDetalheRpg('<%= initialRpg %>', true);
    });
    <%
    }
    %>

    function filtrarCatalogo() {
      const q = document.getElementById('cat-search').value.toLowerCase().trim();
      document.querySelectorAll('#catalog-grid-container .cat-section').forEach(section => {
        let visible = 0;
        section.querySelectorAll('.cat-card').forEach(card => {
          const nome = card.dataset.nome.toLowerCase();
          const genre = card.dataset.genre.toLowerCase();
          const rpg = catRpgData.find(r => r.name.toLowerCase() === nome);
          const tags = (rpg?.tags || []).map(t => t.name.toLowerCase()).join(' ');
          const match = !q || nome.includes(q) || genre.includes(q) || tags.includes(q);
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        const countEl = section.querySelector('.cat-genre-count');
        if (countEl) countEl.textContent = visible;
        section.style.display = visible ? '' : 'none';
      });
    }

    function ordenarCatalogo(tipo) {
      currentSort = tipo;
      document.querySelectorAll('#sort-nome, #sort-popular, #sort-nota').forEach(b => {
        b.style.background = 'var(--bg-input)';
        b.style.color = 'var(--text-muted)';
        b.style.border = '1px solid var(--border)';
      });
      const active = document.getElementById('sort-' + tipo);
      if (active) { active.style.background = 'var(--accent)'; active.style.color = 'white'; active.style.border = 'none'; }

      const container = document.getElementById('catalog-grid-container');
      const sections = [...container.querySelectorAll('.cat-section')];

      sections.forEach(s => s.classList.remove('hidden'));
      sections.forEach(s => s.querySelector('.cat-section-title')?.classList.remove('hidden'));
      sections.forEach(section => {
        const cards = [...section.querySelectorAll('.cat-card')];
        const grid = section.querySelector('.grid');
        if (tipo === 'nome') {
          cards.sort((a, b) => a.dataset.nome.localeCompare(b.dataset.nome));
        } else if (tipo === 'popular') {
          const counts = {};
          catReviewData.forEach(r => { counts[r.rpg.name] = (counts[r.rpg.name] || 0) + 1; });
          cards.sort((a, b) => (counts[b.dataset.nome] || 0) - (counts[a.dataset.nome] || 0));
        } else if (tipo === 'nota') {
          const ratings = {};
          catReviewData.forEach(r => {
            if (!ratings[r.rpg.name]) ratings[r.rpg.name] = [];
            ratings[r.rpg.name].push(r.rating);
          });
          const avgs = {};
          Object.keys(ratings).forEach(k => { avgs[k] = ratings[k].reduce((a,b) => a+b, 0) / ratings[k].length; });
          cards.sort((a, b) => {
            const va = avgs[a.dataset.nome], vb = avgs[b.dataset.nome];
            if (va && !vb) return -1;
            if (!va && vb) return 1;
            return (vb || 0) - (va || 0);
          });
        }
        cards.forEach(c => grid.appendChild(c));
      });
    }

    function renderCatalogo() {
      const container = document.getElementById('catalog-grid-container');
      const generos = [...new Set(catRpgData.map(r => r.genre))].sort((a, b) => a.localeCompare(b));
      const starColor = getComputedStyle(document.documentElement).getPropertyValue('--star').trim() || '#f59e0b';
      container.innerHTML = generos.map(genre => {
        const itens = catRpgData.filter(r => r.genre === genre);
        return `<div class="cat-section" data-genre="${genre.replace(/"/g, '&quot;')}">
          <h3 class="cat-section-title text-base font-title font-bold mb-4 flex items-center gap-2" style="color: var(--text-primary);">
            <span class="w-1 h-4 rounded-full inline-block" style="background: var(--accent);"></span>
            <span class="cat-genre-name">${genre}</span>
            <span class="text-[10px] font-normal" style="color: var(--text-muted);">(<span class="cat-genre-count">${itens.length}</span>)</span>
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
            ${itens.map(rpg => {
              const revs = catReviewData.filter(r => r.rpg.name === rpg.name);
              const media = revs.length ? (revs.reduce((s, r) => s + r.rating, 0) / revs.length) : 0;
              const noRevs = revs.length === 0;
              const blurClass = rpg.ageRating === '18' && rpg.blurImage ? ' cat-blur' : '';
              const desc = rpg.description ? rpg.description.substring(0, 90).replace(/"/g, '&quot;') : '';
              const owner = (rpg.owner || '').replace(/"/g, '&quot;');
              return `<div onclick="selecionarRpgCatalogo('${rpg.name.replace(/'/g, "\\'")}', this)" class="cat-card rounded-xl overflow-hidden border" data-nome="${rpg.name.replace(/"/g, '&quot;')}" data-genre="${rpg.genre.replace(/"/g, '&quot;')}" data-owner="${owner}" data-desc="${desc}" style="background: var(--bg-card); border-color: var(--border); aspect-ratio: 2/3;">
                <img src="${rpg.image}" class="w-full h-full object-cover${blurClass}" alt="${rpg.name.replace(/"/g, '&quot;')}">
                <span class="cat-age-badge ${rpg.ageRating}">${rpg.ageRating === 'L' ? 'L' : rpg.ageRating}</span>
                <div class="cat-rating-badge absolute top-8 right-2 z-3 flex items-center gap-1 text-[9px] font-bold px-1.5 py-0.5 rounded" style="background:rgba(0,0,0,0.7);color:${starColor};backdrop-filter:blur(4px);${noRevs ? 'opacity:0.4;' : ''}">
                  <i class="fa-solid fa-star text-[7px]"></i> ${media.toFixed(1)}
                </div>
                <div class="cat-overlay"></div>
                <div class="cat-label">
                  <h4 class="font-title font-bold text-sm" style="color: white; text-shadow: 0 1px 4px rgba(0,0,0,0.8);">${rpg.name.replace(/"/g, '&quot;')}</h4>
                  <p class="text-[10px] mt-0.5 truncate" style="color: rgba(255,255,255,0.6);">${owner}</p>
                  <p class="text-[9px] mt-1 leading-tight line-clamp-2" style="color: rgba(255,255,255,0.5);">${desc}</p>
                </div>
              </div>`;
            }).join('')}
          </div>
        </div>`;
      }).join('');
    }

    async function refreshData() {
      try {
        const [rpgsRes, usersRes] = await Promise.all([
          fetch('/api/rpgs'),
          fetch('/api/auth/users'),
        ]);
        if (rpgsRes.ok) {
          const rpgs = await rpgsRes.json();
          catRpgData = rpgs;
          heroRpgs = rpgs.filter(r => r.featured).length ? rpgs.filter(r => r.featured) : [rpgs[0]];
          heroIndex = 0;
          renderCatalogo();
          atualizarHero();
          atualizarSearchOptions();
        }
        if (usersRes.ok) {
          catUsersData = await usersRes.json();
        }
      } catch {}
    }

    function atualizarSearchOptions() {
      const select = document.querySelector('#form-rpg');
      if (!select) return;
      const current = select.value;
      select.innerHTML = catRpgData.map(r => `<option value="${r.name.replace(/"/g, '&quot;')}">${r.name.replace(/"/g, '&quot;')}</option>`).join('');
      select.value = current;
    }

    function atualizarMediasCatalogo() {
      document.querySelectorAll('.cat-card').forEach(card => {
        const nome = card.dataset.nome;
        const revs = catReviewData.filter(r => r.rpg.name === nome);
        const media = revs.length ? (revs.reduce((s, r) => s + r.rating, 0) / revs.length) : 0;
        const noRevs = revs.length === 0;
        let badge = card.querySelector('.cat-rating-badge');
        if (!badge) {
          badge = document.createElement('div');
          badge.className = 'cat-rating-badge absolute top-8 right-2 z-3 flex items-center gap-1 text-[9px] font-bold px-1.5 py-0.5 rounded';
          badge.style.cssText = 'background:rgba(0,0,0,0.7);color:var(--star);backdrop-filter:blur(4px);';
          card.appendChild(badge);
        }
        badge.style.opacity = noRevs ? '0.4' : '1';
        badge.innerHTML = '<i class="fa-solid fa-star text-[7px]"></i> ' + media.toFixed(1);
      });
    }

    function atualizarHero() {
      const featured = catRpgData.filter(r => r.featured);
      heroRpgs = featured.length ? featured : [catRpgData[0]];
      heroIndex = 0;
      heroIrPara(null, 0);
      const dots = document.getElementById('hero-dots');
      if (heroRpgs.length < 2) {
        if (dots) dots.innerHTML = '';
        pararHero();
        return;
      }
      if (dots) {
        dots.innerHTML = heroRpgs.map((_, i) => `
          <button onclick="heroIrPara(event, ${i})" class="w-1.5 h-1.5 rounded-full transition-all" style="background:${i === 0 ? 'var(--accent)' : 'rgba(255,255,255,0.4)'};${i === 0 ? 'width:16px;' : ''}"></button>
        `).join('');
      }
      iniciarHero();
    }

    function abrirPerfil() {
      const user = getUser();
      if (!user) { abrirModalLogin(); return; }
      preencherPerfil(user.username, true);
    }

    function verPerfil(username) {
      preencherPerfil(username, false);
    }

    function preencherPerfil(username, isOwn) {
      let user = catUsersData.find(u => u.username === username);
      if (!user && isOwn) {
        user = getUser();
      }
      if (!user) return;
      document.getElementById('perfil-nome').textContent = user.username;
      document.getElementById('perfil-role').textContent = user.role === 'admin' ? 'Administrador' : 'Usuário';
      document.getElementById('perfil-bio').value = user.bio || '';
      const avatar = document.getElementById('perfil-avatar');
      const placeholder = document.getElementById('perfil-avatar-placeholder');
      if (user.avatar) { avatar.src = user.avatar; avatar.classList.remove('hidden'); placeholder.classList.add('hidden'); }
      else { avatar.classList.add('hidden'); placeholder.classList.remove('hidden'); placeholder.textContent = user.username.charAt(0).toUpperCase(); }

      document.getElementById('perfil-camera-label').classList.toggle('hidden', !isOwn);
      document.getElementById('perfil-bio').disabled = !isOwn;
      document.getElementById('perfil-save-btn').classList.toggle('hidden', !isOwn);
      document.getElementById('perfil-logout-btn').classList.toggle('hidden', !isOwn);
      document.getElementById('perfil-reviews-heading').textContent = isOwn ? 'Minhas Críticas' : `Críticas de ${user.username}`;

      const list = document.getElementById('perfil-reviews');
      const minhas = allReviewData.filter(r => r.username === user.username);
      if (minhas.length) {
        list.innerHTML = minhas.map(r => {
          const isPending = r.status === 'pending';
          return `
          <div class="rounded-xl p-3 border" style="background:color-mix(in srgb, var(--bg-card) 50%, transparent);border-color:var(--border);">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[11px] font-semibold" style="color:var(--text-secondary);">${r.rpg.name}</span>
              <div class="flex items-center gap-2">
                ${isPending ? '<span class="text-[8px] font-bold px-1.5 py-0.5 rounded uppercase tracking-wider" style="background:#f59e0b20;color:#f59e0b;border:1px solid #f59e0b40;">Pendente</span>' : ''}
                <span class="text-[10px]" style="color:var(--star);">${'★'.repeat(Math.floor(r.rating))}${r.rating % 1 ? '½' : ''} ${r.rating}</span>
              </div>
            </div>
            <p class="text-[11px] leading-relaxed" style="color:var(--text-muted);">${r.comment}</p>
            <span class="text-[9px]" style="color:var(--text-muted);">${r.timeAgo}</span>
          </div>
        `}).join('');
      } else {
        list.innerHTML = '<p class="text-xs text-center py-4" style="color:var(--text-muted);">Nenhuma crítica.</p>';
      }

      const modal = document.getElementById('modal-perfil');
      modal.classList.remove('modal-hidden');
    }

    function fecharPerfil() {
      document.getElementById('modal-perfil').classList.add('modal-hidden');
    }

    async function enviarAvatar(event) {
      const file = event.target.files[0];
      if (!file) return;
      const token = getToken();
      if (!token) return;
      const formData = new FormData();
      formData.append('avatar', file);
      try {
        const res = await fetch('/api/auth/profile', { method: 'PATCH', headers: { 'Authorization': `Bearer ${token}` }, body: formData });
        const data = await res.json();
        if (!res.ok) { alert(data.error); return; }
        saveSession(token, data.user);
        const user = getUser();
        if (user?.avatar) { document.getElementById('perfil-avatar').src = user.avatar; document.getElementById('perfil-avatar').classList.remove('hidden'); document.getElementById('perfil-avatar-placeholder').classList.add('hidden'); }
        atualizarNavbar();
      } catch { alert('Erro ao enviar avatar.'); }
    }

    async function salvarPerfil() {
      const token = getToken();
      if (!token) return;
      const bio = document.getElementById('perfil-bio').value.trim();
      try {
        const res = await fetch('/api/auth/profile', { method: 'PATCH', headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }, body: JSON.stringify({ bio }) });
        const data = await res.json();
        if (!res.ok) { alert(data.error); return; }
        saveSession(token, data.user);
        alert('Perfil salvo!');
      } catch { alert('Erro ao salvar.'); }
    }

    async function fazerLogout() {
      fecharPerfil();
      const token = getToken();
      if (token) await fetch('/api/auth/logout', { method: 'POST', headers: { 'Authorization': `Bearer ${token}` } }).catch(() => {});
      clearSession();
      atualizarNavbar();
    }

    async function verificarSessao() {
      const token = getToken();
      if (!token) return;
      try {
        const res = await fetch('/api/auth/me', { headers: { 'Authorization': `Bearer ${token}` } });
        if (res.ok) { const data = await res.json(); saveSession(token, data.user); }
        else { clearSession(); }
      } catch { clearSession(); }
      atualizarNavbar();
    }

    function mostrarErro(id, msg) { const el = document.getElementById(id); el.textContent = msg; el.classList.remove('hidden'); }
    function esconderErro(id) { document.getElementById(id).classList.add('hidden'); }

    async function fazerLogin(event) {
      event.preventDefault();
      esconderErro('login-error');
      try {
        const res = await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: document.getElementById('login-username').value, password: document.getElementById('login-password').value }) });
        const data = await res.json();
        if (!res.ok) { mostrarErro('login-error', data.error); return; }
        saveSession(data.token, data.user);
        atualizarNavbar();
        fecharModalLogin();
        document.getElementById('form-login').reset();
        try {
          const usersRes = await fetch('/api/auth/users');
          if (usersRes.ok) catUsersData = await usersRes.json();
        } catch {}
      } catch { mostrarErro('login-error', 'Erro ao conectar com o servidor.'); }
    }

    function previewRegAvatar(input) {
      const file = input.files[0];
      if (!file) return;
      document.getElementById('reg-file-name').textContent = file.name;
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('reg-avatar-preview');
        preview.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">`;
      };
      reader.readAsDataURL(file);
    }

    async function fazerRegistro(event) {
      event.preventDefault();
      esconderErro('reg-error');
      try {
        const formData = new FormData();
        formData.append('username', document.getElementById('reg-username').value);
        formData.append('password', document.getElementById('reg-password').value);
        const contact = document.getElementById('reg-contact').value.trim();
        if (contact) formData.append('contact', contact);
        const avatarFile = document.getElementById('reg-avatar').files[0];
        if (avatarFile) formData.append('avatar', avatarFile);
        const res = await fetch('/api/auth/register', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) { mostrarErro('reg-error', data.error); return; }
        saveSession(data.token, data.user);
        atualizarNavbar();
        fecharModalRegistro();
        document.getElementById('form-registro').reset();
        document.getElementById('reg-avatar-preview').innerHTML = '<i class="fa-solid fa-camera text-sm"></i>';
        document.getElementById('reg-file-name').textContent = 'Nenhum';
        try {
          const usersRes = await fetch('/api/auth/users');
          if (usersRes.ok) catUsersData = await usersRes.json();
        } catch {}
      } catch { mostrarErro('reg-error', 'Erro ao conectar com o servidor.'); }
    }

    function toggleSearch() {
      const s = document.getElementById('search-section');
      s.classList.toggle('hidden');
      if (!s.classList.contains('hidden')) document.getElementById('search-input').focus();
    }

    function buscarNoFeed() {
      const q = document.getElementById('search-input').value.toLowerCase();
      document.querySelectorAll('.feed-card').forEach(c => { c.style.display = c.textContent.toLowerCase().includes(q) ? 'flex' : 'none'; });
    }

    function filtrarRPG(nome) {
      document.querySelectorAll('.feed-card').forEach(c => { c.style.display = c.getAttribute('data-rpg') === nome ? 'flex' : 'none'; });
    }

    function limparFiltros() {
      document.querySelectorAll('.feed-card').forEach(c => c.style.display = 'flex');
      document.getElementById('search-input').value = '';
    }

    function abrirModalAvaliacao(rpgNome) {
      const user = getUser();
      if (!user) { abrirModalLogin(); return; }
      document.getElementById('current-user-name').textContent = user.username;
      const badge = document.getElementById('current-user-badge');
      const avatarImg = document.getElementById('current-user-avatar-img');
      const avatarLetter = document.getElementById('current-user-avatar-letter');
      if (user.avatar) { avatarImg.src = user.avatar; avatarImg.classList.remove('hidden'); avatarLetter.classList.add('hidden'); }
      else { avatarImg.classList.add('hidden'); avatarLetter.classList.remove('hidden'); avatarLetter.textContent = user.username.charAt(0).toUpperCase(); }
      document.getElementById('form-rating').value = '0';
      document.querySelectorAll('#star-rating i').forEach(s => { s.className = 'fa-regular fa-star cursor-pointer transition-colors'; s.style.color = 'var(--text-muted)'; });
      document.getElementById('rating-label').textContent = '-';
      document.getElementById('form-comment').value = '';
      document.getElementById('form-image').value = '';
      document.getElementById('file-name').textContent = 'Nenhum';
      if (rpgNome) {
        const select = document.getElementById('form-rpg');
        for (let opt of select.options) { if (opt.value === rpgNome) { select.value = rpgNome; break; } }
      }
      document.getElementById('modal-avaliacao').classList.remove('modal-hidden');
    }

    function fecharModalAvaliacao() { document.getElementById('modal-avaliacao').classList.add('modal-hidden'); }
    function abrirModalLogin() { esconderErro('login-error'); document.getElementById('form-login').reset(); document.getElementById('modal-login').classList.remove('modal-hidden'); }
    function fecharModalLogin() { document.getElementById('modal-login').classList.add('modal-hidden'); }
    function abrirModalRegistro() { fecharModalLogin(); esconderErro('reg-error'); document.getElementById('form-registro').reset(); document.getElementById('modal-registro').classList.remove('modal-hidden'); }
    function fecharModalRegistro() { document.getElementById('modal-registro').classList.add('modal-hidden'); }
    function atualizarNomeArquivo(input) { document.getElementById('file-name').textContent = input.files.length > 0 ? input.files[0].name : 'Nenhum arquivo selecionado'; }
    function abrirConfiguracoes() { document.getElementById('modal-config').classList.remove('modal-hidden'); }
    function fecharConfiguracoes() { document.getElementById('modal-config').classList.add('modal-hidden'); }

    document.querySelectorAll('#star-rating i').forEach(star => {
      star.addEventListener('click', function() {
        const value = parseInt(this.dataset.value);
        document.getElementById('form-rating').value = value;
        const starColor = getComputedStyle(document.documentElement).getPropertyValue('--star').trim() || '#f59e0b';
        const mutedColor = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim() || '#64748b';
        document.querySelectorAll('#star-rating i').forEach((s, i) => {
          s.className = i < value ? 'fa-solid fa-star transition-colors' : 'fa-regular fa-star transition-colors';
          s.style.color = i < value ? starColor : mutedColor;
        });
        const labels = ['', 'Péssimo', 'Ruim', 'Regular', 'Bom', 'Excelente'];
        document.getElementById('rating-label').textContent = labels[value];
      });
    });

    async function postarAvaliacao(event) {
      event.preventDefault();
      const token = getToken();
      if (!token) { fecharModalAvaliacao(); abrirModalLogin(); return; }
      const rpgName = document.getElementById('form-rpg').value;
      const rating = document.getElementById('form-rating').value;
      const comment = document.getElementById('form-comment').value;
      const imageFile = document.getElementById('form-image').files[0];
      if (rating === '0') { alert('Selecione uma nota com as estrelas.'); return; }
      const formData = new FormData();
      formData.append('rpgName', rpgName);
      formData.append('rating', rating);
      formData.append('comment', comment);
      if (imageFile) formData.append('image', imageFile);
      try {
        const res = await fetch('/api/reviews', { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, body: formData });
        if (!res.ok) {
          const err = await res.json();
          if (res.status === 401) { clearSession(); atualizarNavbar(); fecharModalAvaliacao(); abrirModalLogin(); return; }
          alert(err.error || 'Erro ao publicar avaliação.'); return;
        }
        const review = await res.json();
        allReviewData.unshift(review);
        if (review.status === 'pending') {
          pendingReviewsData.push(review);
          atualizarNavbar();
          fecharModalAvaliacao();
          alert('Sua avaliação foi enviada para aprovação. Ela aparecerá no feed após ser aprovada por um administrador.');
          return;
        }
        catReviewData.push(review);
        const starColor = getComputedStyle(document.documentElement).getPropertyValue('--star').trim() || '#f59e0b';
        let estrelasHTML = '';
        for (let i = 1; i <= 5; i++) {
          if (i <= Math.floor(review.rating)) estrelasHTML += `<i class="fas fa-star" style="color:${starColor}"></i> `;
          else if (i === Math.ceil(review.rating) && review.rating % 1 !== 0) estrelasHTML += `<i class="fas fa-star-half-alt" style="color:${starColor}"></i> `;
          else estrelasHTML += `<i class="far fa-star" style="color:${starColor}; opacity:0.4"></i> `;
        }
        const imgSrc = review.customImage || review.rpg.image;
        const bgCard = getComputedStyle(document.documentElement).getPropertyValue('--bg-card').trim();
        const bgElevated = getComputedStyle(document.documentElement).getPropertyValue('--bg-elevated').trim();
        const border = getComputedStyle(document.documentElement).getPropertyValue('--border').trim();
        const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
        const textPrimary = getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim();
        const textSecondary = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim();
        const textMuted = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim();
        const novoCard = document.createElement('div');
        novoCard.className = 'feed-card rounded-2xl p-4.5 border transition-all duration-300 shadow-sm flex flex-col space-y-3.5';
        novoCard.style.cssText = `background:color-mix(in srgb, ${bgCard} 40%, transparent);border-color:${border};`;
        novoCard.setAttribute('data-rpg', review.rpg.name);
        novoCard.innerHTML = `
          <div class="flex items-center space-x-3 p-2.5 rounded-xl border" style="background:color-mix(in srgb, ${bgElevated} 40%, transparent);border-color:${border};">
            <img src="${imgSrc}" class="w-12 h-14 object-cover rounded-lg shadow-md" alt="Capa ${review.rpg.name}">
            <div class="flex-1 min-w-0">
              <span class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wide uppercase font-title" style="background:color-mix(in srgb, ${accent} 15%, transparent);color:${accent};">${review.rpg.genre}</span>
              <h3 class="font-title font-bold text-sm truncate mt-0.5 cursor-pointer hover:underline rpg-name" style="color:${textPrimary};" onclick="abrirDetalheRpg('${review.rpg.name}')">${review.rpg.name}</h3>
              <p class="text-[10px] truncate" style="color:${textMuted};">Por: <span class="rpg-owner">${review.rpg.owner}</span></p>
            </div>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
              <div onclick="verPerfil('${review.username}')" class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm cursor-pointer" style="background:color-mix(in srgb, ${accent} 15%, transparent);border:1px solid color-mix(in srgb, ${accent} 30%, transparent);color:${accent};">${review.username.charAt(0).toUpperCase()}</div>
              <div>
                <h4 onclick="verPerfil('${review.username}')" class="font-bold text-xs cursor-pointer hover:underline" style="color:${textSecondary};">${review.username}</h4>
                <span class="text-[9px]" style="color:${textMuted};">${review.timeAgo}</span>
              </div>
            </div>
            <div class="flex items-center space-x-0.5 text-[10px] px-2 py-1 rounded-full border" style="color:${starColor};background:color-mix(in srgb, ${starColor} 10%, transparent);border-color:color-mix(in srgb, ${starColor} 20%, transparent);">
              ${estrelasHTML}
              <span class="text-[10px] ml-1 font-semibold" style="color:${starColor};">${review.rating}</span>
            </div>
          </div>
          <p class="text-xs leading-relaxed comment-text pl-1" style="color:${textSecondary};">${review.comment}</p>
          <div class="flex justify-end">
            <button onclick="deletarAvaliacao('${review.id}', this)" class="review-delete-btn text-[9px] px-2 py-1 rounded-lg font-bold transition-all hidden active:scale-[0.94]" style="color:#ef4444;background:color-mix(in srgb, #ef4444 10%, transparent);border:1px solid color-mix(in srgb, #ef4444 20%, transparent);" data-owner="${review.username}">
              <i class="fa-solid fa-trash-alt mr-1"></i>Excluir
            </button>
          </div>
        `;
        const feed = document.getElementById('feed-container');
        feed.insertBefore(novoCard, feed.firstChild);
        document.getElementById('form-avaliacao').reset();
        document.getElementById('file-name').textContent = 'Nenhum arquivo selecionado';
        document.querySelectorAll('#star-rating i').forEach(s => { s.className = 'fa-regular fa-star cursor-pointer transition-colors'; s.style.color = 'var(--text-muted)'; });
        document.getElementById('rating-label').textContent = 'Selecione';
        fecharModalAvaliacao();
      } catch (err) { alert('Erro ao conectar com o servidor.'); }
    }

    carregarTema();
    abrirCatalogo();
    setInterval(async () => {
      try {
        const res = await fetch('/api/reviews');
        if (res.ok) {
          const data = await res.json();
          const currentIds = new Set(catReviewData.map(r => r.id));
          const novas = data.filter(r => !currentIds.has(r.id));
          if (novas.length) {
            novas.forEach(n => catReviewData.push(n));
            atualizarMediasCatalogo();
          }
        }
      } catch {}
    }, 15000);

    const themeVars = ['--bg-primary','--bg-secondary','--bg-card','--bg-elevated','--bg-input','--accent','--text-primary','--text-secondary','--text-muted','--border','--star'];
    themeVars.forEach(v => {
      const el = document.getElementById('cp-' + v.replace('--', ''));
      if (!el) return;
      const val = getComputedStyle(document.documentElement).getPropertyValue(v).trim();
      if (val && val.startsWith('#')) el.value = val;
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        if (!document.getElementById('modal-perfil').classList.contains('modal-hidden')) fecharPerfil();
        if (!document.getElementById('modal-pendentes').classList.contains('modal-hidden')) fecharModalPendentes();
      }
    });

    verificarSessao();
    iniciarHero();
  </script>
</body>
</html>