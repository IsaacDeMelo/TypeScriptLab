    <!-- CROPPER MODAL -->
    <div id="modal-cropper" class="modal-hidden fixed inset-0 z-[60] flex items-center justify-center p-4" style="background: color-mix(in srgb, #000 90%, transparent);">
      <div class="rounded-3xl w-full max-w-2xl shadow-2xl overflow-hidden" style="background: var(--bg-card); border: 1px solid var(--border);">
        <div class="p-4 border-b flex items-center justify-between" style="border-color: var(--border);">
          <h3 class="text-sm font-bold font-title flex items-center gap-2" style="color: var(--text-primary);">
            <i class="fa-solid fa-crop" style="color: var(--accent);"></i>
            Ajustar Imagem
          </h3>
          <button onclick="fecharCropper()" class="p-2 rounded-xl transition" style="color: var(--text-muted);">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="p-4">
          <div id="cropper-container" class="w-full max-h-[55vh] bg-black rounded-2xl overflow-hidden">
            <img id="cropper-image" src="" alt="Cortar" style="max-width: 100%;">
          </div>
          <div class="flex items-center justify-between mt-4">
            <div class="flex gap-2">
              <button onclick="cropperSetRatio(2/3)" class="px-3 py-1.5 rounded-lg text-[10px] font-bold transition" style="background: var(--bg-input); color: var(--text-secondary); border: 1px solid var(--border);">Card (2:3)</button>
              <button onclick="cropperSetRatio(16/9)" class="px-3 py-1.5 rounded-lg text-[10px] font-bold transition" style="background: var(--bg-input); color: var(--text-secondary); border: 1px solid var(--border);">Banner (16:9)</button>
              <button onclick="cropperSetRatio(NaN)" class="px-3 py-1.5 rounded-lg text-[10px] font-bold transition" style="background: var(--bg-input); color: var(--text-secondary); border: 1px solid var(--border);">Livre</button>
            </div>
            <button onclick="confirmarCropper()" class="px-5 py-2 rounded-xl text-xs font-bold text-white transition active:scale-95" style="background: var(--accent);">
              <i class="fa-solid fa-check"></i> Aplicar
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- JAVASCRIPT -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
  <script>
    const TOKEN_KEY = 'rpg-reviewer-token';
    const USER_KEY = 'rpg-reviewer-user';
    const THEME_KEY = 'rpg-reviewer-theme';
    let cropperInstance = null;
    let cropperCallback = null;
    let croppedImageFile = null;
    let croppedBannerFile = null;
    let croppedEditImageFile = null;
    let croppedEditBannerFile = null;

    function abrirCropper(imgSrc, callback) {
      const img = document.getElementById('cropper-image');
      img.src = imgSrc;
      cropperCallback = callback;
      document.getElementById('modal-cropper').classList.remove('modal-hidden');
      img.onload = () => {
        if (cropperInstance) cropperInstance.destroy();
        cropperInstance = new Cropper(img, {
          aspectRatio: 2/3,
          viewMode: 1,
          dragMode: 'move',
          background: false,
          autoCropArea: 1,
        });
      };
    }
    function fecharCropper() {
      if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
      document.getElementById('modal-cropper').classList.add('modal-hidden');
      cropperCallback = null;
    }
    function cropperSetRatio(ratio) {
      if (!cropperInstance) return;
      if (isNaN(ratio)) cropperInstance.setAspectRatio(NaN);
      else cropperInstance.setAspectRatio(ratio);
    }
    function confirmarCropper() {
      if (!cropperInstance) return;
      const canvas = cropperInstance.getCroppedCanvas({ maxWidth: 1200, maxHeight: 1200 });
      canvas.toBlob(blob => {
        const file = new File([blob], 'cropped.png', { type: 'image/png' });
        if (cropperCallback) cropperCallback(file);
        fecharCropper();
      }, 'image/png');
    }
    function abrirCropperParaImagem(input, labelId) {
      const file = input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = e => abrirCropper(e.target.result, cropped => {
        croppedImageFile = cropped;
        document.getElementById(labelId).textContent = file.name + ' (cortado)';
      });
      reader.readAsDataURL(file);
    }

    const THEME_DEFAULTS = {
      '--bg-primary': '#0b0f19',
      '--bg-secondary': '#0f1524',
      '--bg-card': '#111827',
      '--bg-elevated': '#1a1f35',
      '--bg-input': '#0a0e1a',
      '--accent': '#e50914',
      '--accent-hover': '#f40612',
      '--text-primary': '#f1f5f9',
      '--text-secondary': '#94a3b8',
      '--text-muted': '#64748b',
      '--border': 'rgba(100,116,139,0.25)',
      '--border-accent': 'rgba(229,9,20,0.3)',
      '--star': '#f59e0b',
    };

    function getToken() { return localStorage.getItem(TOKEN_KEY); }
    function getUser() {
      try { return JSON.parse(localStorage.getItem(USER_KEY)); }
      catch { return null; }
    }
    function saveSession(token, user) {
      localStorage.setItem(TOKEN_KEY, token);
      localStorage.setItem(USER_KEY, JSON.stringify(user));
    }
    function clearSession() {
      localStorage.removeItem(TOKEN_KEY);
      localStorage.removeItem(USER_KEY);
    }

    function aplicarCor(varName, value) {
      document.documentElement.style.setProperty(varName, value);
      salvarTema();
    }

    function salvarTema() {
      const theme = {};
      Object.keys(THEME_DEFAULTS).forEach(key => {
        theme[key] = document.documentElement.style.getPropertyValue(key) || THEME_DEFAULTS[key];
      });
      localStorage.setItem(THEME_KEY, JSON.stringify(theme));
    }

    function carregarTema() {
      const saved = localStorage.getItem(THEME_KEY);
      if (!saved) return;
      try {
        const theme = JSON.parse(saved);
        Object.entries(theme).forEach(([key, value]) => {
          if (value) document.documentElement.style.setProperty(key, value);
        });
      } catch {}
    }

    function resetarTema() {
      Object.entries(THEME_DEFAULTS).forEach(([key, value]) => {
        document.documentElement.style.setProperty(key, value);
      });
      Object.keys(THEME_DEFAULTS).forEach(key => {
        const cp = document.getElementById('cp-' + key.replace('--', ''));
        if (cp) cp.value = THEME_DEFAULTS[key];
      });
      localStorage.removeItem(THEME_KEY);
    }

    function exportarTema() {
      const theme = {};
      Object.keys(THEME_DEFAULTS).forEach(key => {
        theme[key] = document.documentElement.style.getPropertyValue(key) || THEME_DEFAULTS[key];
      });
      const text = Object.entries(theme).map(([k, v]) => `${k}: ${v}`).join('\n');
      navigator.clipboard.writeText(text).then(() => {
        alert('Tema copiado para a área de transferência!');
      }).catch(() => {
        prompt('Copie o texto abaixo:', text);
      });
    }

    function toggleThemePanel() {
      const content = document.getElementById('theme-panel-content');
      const btn = document.querySelector('#theme-panel > button');
      content.classList.toggle('hidden');
      btn.classList.toggle('hidden');
    }

    function abrirCatalogo() {
      document.getElementById('feed-view').classList.add('hidden');
      const modal = document.getElementById('modal-catalogo');
      modal.classList.remove('modal-hidden');
      void modal.offsetHeight;
      modal.classList.add('catalogo-aberto');
      document.body.style.overflow = 'hidden';
      document.getElementById('nav-catalogo').style.color = 'var(--accent)';
      document.getElementById('nav-feed').style.color = 'var(--text-muted)';
      iniciarHero();
    }

    function abrirFeed() {
      const modal = document.getElementById('modal-catalogo');
      modal.classList.remove('catalogo-aberto');
      setTimeout(() => {
        modal.classList.add('modal-hidden');
        document.getElementById('feed-view').classList.remove('hidden');
        document.body.style.overflow = '';
      }, 100);
      document.getElementById('nav-feed').style.color = 'var(--accent)';
      document.getElementById('nav-catalogo').style.color = 'var(--text-muted)';
    }

    function revelarBlur(el) {
      const img = el?.querySelector('.cat-blur');
      if (img && !img.classList.contains('revealed')) {
        img.classList.add('revealed');
      }
    }

    function toggleRegBlurOption() {
      const age = document.getElementById('reg-age').value;
      document.getElementById('reg-blur-container').classList.toggle('hidden', age !== '18');
    }

    function toggleEditBlurOption() {
      const age = document.getElementById('edit-age').value;
      document.getElementById('edit-blur-container').classList.toggle('hidden', age !== '18');
    }

    let heroInterval, heroIndex = 0, heroPausado = false, heroTouchX = 0, heroSwipeInit = false, heroRpgs = <%- JSON.stringify(rpgs.filter(r => r.featured).length ? rpgs.filter(r => r.featured) : [rpgs[0]]) %>;

    function iniciarHero() {
      pararHero();
      if (heroRpgs.length < 2) return;
      iniciarHeroSwipe();
      heroInterval = setInterval(() => {
        if (heroPausado) return;
        heroIndex = (heroIndex + 1) % heroRpgs.length;
        heroIrPara(null, heroIndex);
      }, 3000);
    }

    function pararHero() { if (heroInterval) { clearInterval(heroInterval); heroInterval = null; } }
    function pausarHero() { heroPausado = true; }
    function retomarHero() { heroPausado = false; }

    function heroIrPara(e, index) {
      if (e) { e.stopPropagation(); pausarHero(); setTimeout(retomarHero, 6000); }
      heroIndex = index;
      const rpg = heroRpgs[index];
      if (!rpg) return;
      const banner = document.getElementById('cat-banner');
      banner.style.opacity = '0';
      setTimeout(() => {
        banner.style.backgroundImage = `url('${rpg.banner}')`;
        banner.style.opacity = '1';
      }, 150);
      document.getElementById('cat-title').textContent = rpg.name;
      document.getElementById('cat-desc').textContent = rpg.description;
      document.getElementById('cat-owner').textContent = `${rpg.owner} · ${rpg.year}`;
      document.getElementById('cat-genre').textContent = rpg.genre;
      document.getElementById('cat-year').textContent = rpg.year || '';
      const dots = document.querySelectorAll('#hero-dots button');
      dots.forEach((d, i) => {
        d.style.background = i === index ? 'var(--accent)' : 'rgba(255,255,255,0.4)';
        d.style.width = i === index ? '16px' : '6px';
      });
    }

    function heroProximo(e) { if (e) e.stopPropagation(); pausarHero(); setTimeout(retomarHero, 6000); heroIndex = (heroIndex + 1) % heroRpgs.length; heroIrPara(null, heroIndex); }
    function heroAnterior(e) { if (e) e.stopPropagation(); pausarHero(); setTimeout(retomarHero, 6000); heroIndex = (heroIndex - 1 + heroRpgs.length) % heroRpgs.length; heroIrPara(null, heroIndex); }

    function iniciarHeroSwipe() {
      if (heroSwipeInit) return;
      heroSwipeInit = true;
      const el = document.getElementById('cat-hero-container');
      if (!el) return;
      el.addEventListener('touchstart', e => { heroTouchX = e.changedTouches[0].screenX; }, { passive: true });
      el.addEventListener('touchend', e => {
        const dx = e.changedTouches[0].screenX - heroTouchX;
        if (Math.abs(dx) > 50) {
          if (dx < 0) heroProximo(); else heroAnterior();
        }
      }, { passive: true });
    }

    function selecionarRpgCatalogo(nome, el) {
      revelarBlur(el);
      const idx = heroRpgs.findIndex(r => r.name === nome);
      if (idx !== -1) { heroIrPara(null, idx); heroIndex = idx; }
      window.scrollTo({ top: 0, behavior: 'smooth' });
      abrirDetalheRpg(nome);
    }

    function abrirDetalheRpg(nome, fromPopstate) {
      const modal = document.getElementById('modal-detalhe');
      const rpgs = <%- JSON.stringify(rpgs) %>;
      const rpg = rpgs.find(r => r.name === nome);
      if (!rpg) return;

      if (!fromPopstate) {
        const slug = toSlug(nome);
        window.history.pushState({ rpg: nome }, '', '/rpg/' + slug);
        document.title = rpg.name + ' — Avaliações e Críticas | Rpflix';
      }
      rpgModalOpen = true;
      document.getElementById('detalhe-banner').style.backgroundImage = `url('${rpg.banner}')`;
      document.getElementById('detalhe-name').textContent = rpg.name;
      document.getElementById('detalhe-owner').textContent = rpg.owner;
      document.getElementById('detalhe-genre').textContent = rpg.genre;
      document.getElementById('detalhe-year').textContent = rpg.year || '';
      const ageEl = document.getElementById('detalhe-age');
      ageEl.textContent = rpg.ageRating === 'L' ? 'Livre' : rpg.ageRating;
      ageEl.style.background = rpg.ageRating === '18' ? 'rgba(0,0,0,0.8)' : rpg.ageRating === '16' ? 'rgba(239,68,68,0.3)' : rpg.ageRating === '14' ? 'rgba(251,146,60,0.3)' : 'rgba(234,179,8,0.2)';
      ageEl.style.color = rpg.ageRating === '18' ? '#fff' : rpg.ageRating === '16' ? '#ef4444' : rpg.ageRating === '14' ? '#fb923c' : '#eab308';
      document.getElementById('detalhe-desc').textContent = rpg.description;
      const tagsContainer = document.getElementById('detalhe-tags');
      if (rpg.tags && rpg.tags.length) {
        tagsContainer.innerHTML = rpg.tags.sort((a, b) => b.weight - a.weight).map(t =>
          `<span class="text-[9px] px-2 py-0.5 rounded font-medium" style="background:color-mix(in srgb, var(--accent) 15%, transparent);color:var(--accent);border:1px solid color-mix(in srgb, var(--accent) 25%, transparent);">${t.name}</span>`
        ).join('');
        tagsContainer.classList.remove('hidden');
      } else {
        tagsContainer.innerHTML = '';
        tagsContainer.classList.add('hidden');
      }
      // Preencher nota em destaque
      const allRevs = <%- JSON.stringify(reviews) %>;
      const rpgRevs = allRevs.filter(r => r.rpg.name === nome);
      const count = rpgRevs.length;
      const avg = count ? (rpgRevs.reduce((s, r) => s + r.rating, 0) / count) : 0;
      const ratingValue = document.getElementById('detalhe-rating-value');
      const ratingStars = document.getElementById('detalhe-rating-stars');
      const ratingCount = document.getElementById('detalhe-rating-count');
      if (count > 0) {
        ratingValue.textContent = avg.toFixed(1);
        ratingStars.innerHTML = '';
        for (let i = 1; i <= 5; i++) {
          const star = document.createElement('i');
          if (i <= Math.floor(avg)) star.className = 'fas fa-star';
          else if (i === Math.ceil(avg) && avg % 1 !== 0) star.className = 'fas fa-star-half-alt';
          else star.className = 'far fa-star';
          star.style.cssText = 'color:var(--star);font-size:9px;';
          ratingStars.appendChild(star);
        }
        ratingCount.textContent = `${count} avaliação${count !== 1 ? 'ões' : ''}`;
      } else {
        ratingValue.textContent = '—';
        ratingStars.innerHTML = '';
        for (let i = 1; i <= 5; i++) {
          const star = document.createElement('i');
          star.className = 'fa-regular fa-star';
          star.style.cssText = 'color:var(--text-muted);font-size:9px;opacity:0.4;';
          ratingStars.appendChild(star);
        }
        ratingCount.textContent = 'Sem avaliações';
      }

      const linkEl = document.getElementById('detalhe-link');
      if (rpg.link) { linkEl.href = rpg.link; linkEl.style.opacity = '1'; linkEl.style.pointerEvents = 'auto'; }
      else { linkEl.href = '#'; linkEl.style.opacity = '0.5'; linkEl.style.pointerEvents = 'none'; }
      const waEl = document.getElementById('detalhe-whatsapp');
      if (rpg.whatsapp) { waEl.href = rpg.whatsapp; waEl.style.opacity = '1'; waEl.style.pointerEvents = 'auto'; }
      else { waEl.href = '#'; waEl.style.opacity = '0.5'; waEl.style.pointerEvents = 'none'; }

      // Preencher críticas deste RPG
      const revs = allRevs.filter(r => r.rpg.name === nome);
      const list = document.getElementById('detalhe-reviews-list');
      const allUsers = <%- JSON.stringify(users) %>;
      if (revs.length) {
        list.innerHTML = revs.map(r => {
          const u = allUsers.find(u => u.username === r.username);
          const avatar = u?.avatar;
          const initial = r.username.charAt(0).toUpperCase();
          return `
          <div class="detalhe-review-card rounded-xl p-3 border" style="background:color-mix(in srgb, var(--bg-card) 50%, transparent);border-color:var(--border);">
            <div class="flex items-center gap-2 mb-1">
              <div onclick="verPerfil('${r.username}')" class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold overflow-hidden shrink-0 cursor-pointer" style="background:var(--accent-dim);color:var(--accent);">
                ${avatar ? `<img src="${avatar}" class="w-full h-full object-cover">` : initial}
              </div>
              <span onclick="verPerfil('${r.username}')" class="text-[11px] font-semibold cursor-pointer hover:underline" style="color:var(--text-secondary);">${r.username}</span>
              <span class="text-[10px] ml-auto" style="color:var(--star);">${'★'.repeat(Math.floor(r.rating))}${r.rating % 1 ? '½' : ''} ${r.rating}</span>
            </div>
            <p class="text-[11px] leading-relaxed" style="color:var(--text-muted);">${r.comment}</p>
            <span class="text-[9px]" style="color:var(--text-muted);">${r.timeAgo}</span>
          </div>`;
        }).join('');
      } else {
        list.innerHTML = '<p class="text-xs text-center py-4" style="color:var(--text-muted);">Nenhuma crítica ainda. Seja o primeiro a avaliar!</p>';
      }

      const user = getUser();
      document.getElementById('btn-avaliar-detalhe').classList.toggle('hidden', !user);
      document.getElementById('btn-avaliar-detalhe').dataset.rpg = nome;
      document.getElementById('btn-editar-detalhe').classList.toggle('hidden', !user || user.role !== 'admin');
      document.getElementById('btn-editar-detalhe').dataset.rpg = nome;
      document.getElementById('btn-deletar-detalhe').classList.toggle('hidden', !user || user.role !== 'admin');
      document.getElementById('btn-deletar-detalhe').dataset.rpg = nome;

      modal.classList.remove('modal-hidden');
      void modal.offsetHeight;
      modal.classList.add('detalhe-aberto');
    }

    function avaliarDoDetalhe() {
      const nome = document.getElementById('btn-avaliar-detalhe').dataset.rpg;
      fecharDetalheRpg();
      setTimeout(() => abrirModalAvaliacao(nome), 100);
    }

    function abrirCropperParaEdicao(input, labelId) {
      const file = input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = e => abrirCropper(e.target.result, cropped => {
        croppedEditImageFile = cropped;
        document.getElementById(labelId).textContent = file.name + ' (cortado)';
      });
      reader.readAsDataURL(file);
    }

